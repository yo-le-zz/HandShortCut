[Desktop Entry]
Type=Application
Version=1.0
Name=PhysicalShortCut
GenericName=Hand gestures
GenericName[fr]=Gestes de la main
Comment=Trigger actions with hand gestures (webcam)
Comment[fr]=Déclenche des actions avec des gestes de la main (webcam)
Exec=physicalshortcut --open
TryExec=physicalshortcut
Icon=physicalshortcut
Terminal=false
Categories=Utility;
Keywords=gesture;hand;camera;shortcut;webcam;geste;main;raccourci;
StartupNotify=false
Actions=stop;

[Desktop Action stop]
Name=Stop PhysicalShortCut
Name[fr]=Arrêter PhysicalShortCut
Exec=physicalshortcut stop
